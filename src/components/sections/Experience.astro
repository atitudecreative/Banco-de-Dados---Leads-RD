---
/**
 * A EXPERIÊNCIA — "Uma noite em sete atos".
 * Desktop: scroll horizontal fixado (src/scripts/experience.ts); o céu muda
 * de índigo (noite) → magenta (celebração) → ouro (virada) com o progresso.
 * Mobile / reduced-motion: linha do tempo vertical, sem fixação.
 *
 * ATENÇÃO: os atos descrevem a atmosfera da noite, NÃO a programação oficial.
 * Ordem e horários oficiais: a definir.
 */
const acts = [
  { title: 'Chegada', text: 'O Rio inteiro chegando pelo mesmo motivo. Família, amigos, caravanas.', visual: 'Rio' },
  { title: 'Louvor', text: 'Milhares de vozes. Uma só canção. O chão vibrando debaixo dos pés.', visual: '♪' },
  { title: 'Palavra', text: 'Uma mensagem pra levar pro ano inteiro — e não esquecer em fevereiro.', visual: '“ ”' },
  { title: 'Oração', text: 'Gratidão pelo que foi. Fé pro que vem. Ninguém ora sozinho aqui.', visual: '✦' },
  { title: 'Contagem', text: 'Dez, nove, oito… a multidão inteira numa voz só.', visual: '10·9·8' },
  { title: 'Virada', text: 'Meia-noite. Abraços, lágrimas, céu aceso. O ano novo começa aqui.', visual: '00:00' },
  { title: 'Celebração', text: 'A festa continua. Porque quem vira o ano com Deus tem motivo pra comemorar.', visual: '∞' },
];
---

<section class="exp" id="experiencia" aria-labelledby="exp-title" data-exp>
  <div class="exp__pin">
    <div class="exp__sky" aria-hidden="true">
      <span class="exp__sky-layer exp__sky-layer--1"></span>
      <span class="exp__sky-layer exp__sky-layer--2"></span>
      <span class="exp__sky-layer exp__sky-layer--3"></span>
    </div>

    <header class="exp__head">
      <div>
        <p class="kicker" data-reveal="fade">A experiência</p>
        <h2 id="exp-title" class="exp__title" data-reveal="mask">
          <span class="line"><span>Uma noite</span></span>
          <span class="line" style="--l:1"><span class="text-gradient">em sete atos.</span></span>
        </h2>
      </div>
      <div class="exp__meta">
        <p class="placeholder-note">Atmosfera da noite · programação oficial em breve</p>
        <div class="exp__progress" aria-hidden="true"><span></span></div>
      </div>
    </header>

    <ol class="exp__track" role="list" data-exp-track>
      {
        acts.map((a, i) => (
          <li class:list={['act', { 'act--virada': a.title === 'Virada' }]} style={`--n:${i}`} data-reveal>
            <span class="act__visual" aria-hidden="true">
              {a.visual}
            </span>
            <span class="act__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="act__body">
              <p class="act__label">
                Ato {String(i + 1).padStart(2, '0')}
                <span class="sr-only"> de 07</span>
              </p>
              <h3 class="act__title">{a.title}</h3>
              <p class="act__text">{a.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .exp {
    --p: 0;
    position: relative;
    background: var(--color-background);
  }

  .exp__pin {
    position: relative;
    padding-block: var(--section-y);
    overflow: hidden;
  }

  /* ---------- Céu que amanhece com o progresso -------------------------- */
  .exp__sky,
  .exp__sky-layer {
    position: absolute;
    inset: 0;
  }

  .exp__sky {
    z-index: 0;
    pointer-events: none;
  }

  .exp__sky-layer--1 {
    background: radial-gradient(70% 60% at 30% 80%, rgb(163 147 237 / 0.45), transparent 70%);
    opacity: calc(1 - var(--p) * 1.2);
  }

  .exp__sky-layer--2 {
    background: radial-gradient(70% 60% at 60% 85%, rgb(255 0 86 / 0.45), transparent 70%);
    opacity: var(--pm, 0);
  }

  .exp__sky-layer--3 {
    background:
      radial-gradient(80% 70% at 80% 90%, rgb(252 151 59 / 0.55), transparent 70%),
      radial-gradient(40% 40% at 85% 20%, rgb(255 0 86 / 0.3), transparent 70%);
    opacity: calc(var(--p) * 1.6 - 0.5);
  }

  .exp__head {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .exp__title {
    margin-top: 1.25rem;
    font-size: var(--fs-h2);
    font-weight: 900;
  }

  .exp__meta {
    display: grid;
    gap: 1rem;
    min-width: min(22rem, 100%);
  }

  .exp__progress {
    display: none;
    height: 2px;
    background: var(--color-line);
  }

  .exp__progress span {
    display: block;
    height: 100%;
    background: var(--gradient-virada);
    transform: scaleX(var(--p));
    transform-origin: left;
  }

  /* ---------- Atos (layout base = vertical/mobile) ---------------------- */
  .exp__track {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0;
    max-width: var(--max-w);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .act {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 2rem;
    border-top: 1px solid var(--color-line);
    overflow: hidden;
  }

  .act__num {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-accent);
  }

  .act__visual {
    position: absolute;
    right: -0.05em;
    top: 50%;
    translate: 0 -50%;
    font-family: var(--font-display);
    font-size: clamp(5rem, 22vw, 9rem);
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.14);
    pointer-events: none;
  }

  .act__label {
    font-size: var(--fs-caption);
    font-weight: 800;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .act__title {
    margin-block: 0.4rem 0.75rem;
    font-size: clamp(2.75rem, 11vw, 6rem);
    font-weight: 900;
    line-height: 0.85;
  }

  .act__text {
    max-width: 26rem;
    color: var(--color-text);
    opacity: 0.85;
  }

  .act--virada .act__title {
    background: var(--gradient-virada);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .act--virada .act__visual {
    -webkit-text-stroke-color: rgb(252 151 59 / 0.4);
  }

  /* ---------- Desktop: scroll horizontal fixado ------------------------- */
  :global(.exp.is-pinned) .exp__pin {
    position: sticky;
    top: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100vh;
    height: 100svh;
    padding-block: calc(var(--nav-h) + 1rem) 3rem;
  }

  :global(.exp.is-pinned) .exp__progress {
    display: block;
  }

  :global(.exp.is-pinned) .exp__head {
    margin-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  :global(.exp.is-pinned) .exp__title {
    font-size: clamp(3rem, min(6vw, 9vh), 6rem);
  }

  :global(.exp.is-pinned) .exp__track {
    display: flex;
    gap: clamp(1.5rem, 3vw, 3rem);
    width: max-content;
    max-width: none;
    margin: 0;
    padding-inline: max(var(--gutter), calc((100vw - var(--max-w)) / 2 + var(--gutter)));
    will-change: transform;
  }

  :global(.exp.is-pinned) .act {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: clamp(22rem, 34vw, 32rem);
    height: min(48vh, 30rem);
    padding: 2rem;
    border: 1px solid var(--color-line);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.01));
    backdrop-filter: blur(2px);
    transition:
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out);
  }

  :global(.exp.is-pinned) .act:hover {
    border-color: rgb(255 255 255 / 0.4);
    transform: translateY(-6px);
  }

  :global(.exp.is-pinned) .act__visual {
    top: 1.25rem;
    right: 1.25rem;
    translate: none;
    font-size: clamp(5rem, 9vw, 9rem);
  }

  :global(.exp.is-pinned) .act__num {
    font-size: 3rem;
  }

  :global(.exp.is-pinned) .act__title {
    font-size: clamp(3.5rem, 5.5vw, 6rem);
  }

  :global(.exp.is-pinned) .act--virada {
    width: clamp(26rem, 42vw, 40rem);
    border-color: transparent;
    background:
      linear-gradient(var(--color-background), var(--color-background)) padding-box,
      var(--gradient-virada) border-box;
    border: 2px solid transparent;
  }

  :global(.exp.is-pinned) .act--virada .act__title {
    font-size: clamp(4.5rem, 8vw, 8.5rem);
  }

  @media (min-width: 761px) {
    .act {
      grid-template-columns: 6rem minmax(0, 1fr);
      padding-block: 2.75rem;
    }

    .act__num {
      font-size: 3rem;
    }
  }
</style>
