---
import Countdown from '@/components/ui/Countdown.astro';
import Button from '@/components/ui/Button.astro';
import { event, dateParts, primaryHref, primaryIsExternal } from '@/config/event';
---

<section class="placar section" id="placar" aria-labelledby="placar-title">
  <div class="placar__leds" aria-hidden="true"></div>
  <div class="container placar__inner">
    <header class="placar__head">
      <p class="kicker" data-reveal="fade">O placar da virada</p>
      <h2 id="placar-title" class="placar__title" data-reveal="mask">
        <span class="line"><span>Está</span></span>
        <span class="line" style="--l:1"><span class="text-gradient">chegando.</span></span>
      </h2>
    </header>

    <div data-reveal="scale">
      <Countdown />
    </div>

    <footer class="placar__foot" data-reveal style="--i:2">
      <p class="placar__when">
        <strong>{dateParts.long}</strong>
        <span>{event.city}</span>
      </p>
      <Button href={primaryHref} external={primaryIsExternal} data-track="cta-placar">Garanta seu lugar</Button>
    </footer>
  </div>
</section>

<style>
  .placar {
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 50% 50%, rgb(59 43 255 / 0.18), transparent 70%),
      var(--color-background);
  }

  /* Matriz de LEDs do telão — textura sutil */
  .placar__leds {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgb(246 243 238 / 0.09) 1px, transparent 1.6px);
    background-size: 9px 9px;
    mask-image: radial-gradient(70% 65% at 50% 50%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(70% 65% at 50% 50%, #000 30%, transparent 75%);
  }

  .placar__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .placar__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .placar__head .kicker {
    order: 2;
  }

  .placar__title {
    font-size: var(--fs-h2);
    font-weight: 900;
  }

  /* Quando o placar zera, a celebração assume o protagonismo */
  .placar:has(.cd.is-done) .placar__title {
    display: none;
  }

  .placar__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .placar__when {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 800;
    text-transform: uppercase;
  }

  .placar__when span {
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .placar__head .kicker {
      order: 0;
    }

    .placar__foot :global(.btn) {
      width: 100%;
    }
  }
</style>
