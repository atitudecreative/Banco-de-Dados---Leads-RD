---
/**
 * HERO — a peça-chave da identidade, viva:
 * moldura roxa, céu rosa→magenta, sol, palmeiras, pássaros, faíscas de
 * Réveillon, multidão e o logotipo oficial montando-se em partes.
 */
import Button from '@/components/ui/Button.astro';
import CrowdSilhouette from '@/components/brand/CrowdSilhouette.astro';
import LockupParts from '@/components/brand/LockupParts.astro';
import { event, dateParts, nextYear, primaryHref, primaryIsExternal } from '@/config/event';

const hasVideo = Boolean(event.heroVideo.webm || event.heroVideo.mp4);
---

<section class="hero" id="topo" aria-labelledby="hero-title" data-hero>
  <div class="hero__card">
    <!-- Cenário: puramente decorativo -->
    <div class="hero__stage" aria-hidden="true">
      <div class="hero__sky"></div>
      <span class="hero__sun"></span>
      <span class="hero__hill hero__hill--1"></span>
      <span class="hero__hill hero__hill--2"></span>
      {
        hasVideo && (
          <video class="hero__video" muted loop playsinline preload="none" data-hero-video>
            {event.heroVideo.webm && <source data-src={event.heroVideo.webm} type="video/webm" />}
            {event.heroVideo.mp4 && <source data-src={event.heroVideo.mp4} type="video/mp4" />}
          </video>
        )
      }
      <div class="hero__beams">
        <span class="beam" style="--x:22%;--r:-24deg;--t:9s"></span>
        <span class="beam" style="--x:50%;--r:3deg;--t:11s"></span>
        <span class="beam" style="--x:78%;--r:26deg;--t:10s"></span>
      </div>
      <canvas class="hero__sparks" data-sparks></canvas>
      <span class="palm palm--left"></span>
      <span class="palm palm--right"></span>
      <span class="birds"></span>
    </div>

    <div class="hero__content">
      <p class="hero__kicker">
        <span class="hero__live"></span>
        Réveillon cristão do Rio<span class="hero__org"> · {event.organizer}</span>
      </p>
      <h1 id="hero-title" class="hero__title">
        <span class="sr-only">
          {event.eventName} {event.eventYear}, {event.edition}: {event.tagline}. Réveillon cristão no {event.city}, {dateParts.long}.
        </span>
        <LockupParts class="hero__logo" />
      </h1>
    </div>

    <div class="hero__crowd" aria-hidden="true">
      <CrowdSilhouette seed={11} />
    </div>

    <div class="hero__bar">
      <div class="hero__date">
        <span class="hero__dd">{dateParts.short}</span>
        <span class="hero__dmeta">
          <span>Virada {dateParts.year} → {nextYear}</span>
          <span>{event.city}</span>
        </span>
      </div>

      <div class="hero__pitch">
        <p class="hero__headline">Viva a virada maravilhosa<span class="hero__dot">.</span></p>
        <p class="hero__sub">Louvor, Palavra e celebração. Milhares de vozes na mesma contagem regressiva, virando o ano na presença de Deus.</p>
      </div>

      <div class="hero__ctas">
        <Button href={primaryHref} external={primaryIsExternal} size="lg" data-track="cta-hero">Quero viver o MaraVira</Button>
        <Button href="#evento" variant="ghost" icon="none">Saiba mais</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --mx: 0;
    --my: 0;
    padding: var(--frame);
    background: var(--brand-purple);
  }

  .hero__card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: calc(100svh - var(--frame) * 2);
    min-height: max(calc(100svh - var(--frame) * 2), 600px);
    padding-top: var(--nav-h);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--brand-pink);
  }

  /* ---------- CENÁRIO ------------------------------------------------- */
  .hero__stage,
  .hero__sky,
  .hero__video,
  .hero__beams,
  .hero__sparks {
    position: absolute;
    inset: 0;
  }

  .hero__stage {
    z-index: -1;
  }

  .hero__sky {
    background: var(--gradient-kv);
  }

  /* Sol nascendo atrás do logotipo: a virada */
  .hero__sun {
    position: absolute;
    right: 8%;
    top: 26%;
    width: min(46vw, 640px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, rgb(252 151 59 / 0.85), rgb(250 121 89 / 0.5) 45%, transparent 70%);
    animation: sun 7s var(--ease-in-out) infinite alternate;
  }

  @keyframes sun {
    from {
      opacity: 0.55;
      transform: translateY(6%) scale(0.95);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Morros/círculos da peça-chave */
  .hero__hill {
    position: absolute;
    border-radius: 50%;
  }

  .hero__hill--1 {
    left: -12%;
    bottom: -40%;
    width: 70vw;
    aspect-ratio: 1;
    background: rgb(255 0 165 / 0.75);
  }

  .hero__hill--2 {
    left: -6%;
    top: 22%;
    width: 50vw;
    aspect-ratio: 1.6;
    background: rgb(255 40 120 / 0.55);
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    mix-blend-mode: soft-light;
    transition: opacity 1.2s var(--ease-out);
  }

  :global(.hero__video.is-ready) {
    opacity: 0.7;
  }

  .hero__beams {
    mix-blend-mode: soft-light;
  }

  .beam {
    position: absolute;
    left: var(--x);
    bottom: 10%;
    width: clamp(90px, 13vw, 220px);
    height: 130%;
    transform-origin: 50% 100%;
    background: linear-gradient(to top, rgb(255 255 255 / 0.95), transparent 75%);
    clip-path: polygon(46% 100%, 54% 100%, 100% 0, 0 0);
    filter: blur(12px);
    translate: -50% 0;
    rotate: var(--r);
    will-change: rotate;
    animation: beam-sweep var(--t) var(--ease-in-out) infinite alternate;
  }

  @keyframes beam-sweep {
    from {
      rotate: calc(var(--r) - 8deg);
    }
    to {
      rotate: calc(var(--r) + 8deg);
    }
  }

  .hero__sparks {
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Palmeiras: silhuetas oficiais, recoloridas por máscara */
  .palm {
    position: absolute;
    top: 0;
    height: 100%;
    aspect-ratio: 440 / 1006;
    background: var(--brand-purple);
    -webkit-mask: var(--m) center / contain no-repeat;
    mask: var(--m) center / contain no-repeat;
    animation: sway 7s var(--ease-in-out) infinite alternate;
  }

  .palm--left {
    --m: url('/brand/palm-left.svg');
    left: 0;
    transform-origin: 0% 100%;
    translate: calc(var(--mx) * 8px) 0;
  }

  .palm--right {
    --m: url('/brand/palm-right.svg');
    right: 0;
    aspect-ratio: 452 / 1006;
    transform-origin: 100% 100%;
    animation-delay: -3s;
    translate: calc(var(--mx) * 12px) 0;
  }

  @keyframes sway {
    from {
      rotate: -1.2deg;
    }
    to {
      rotate: 1.2deg;
    }
  }

  .birds {
    position: absolute;
    left: 12%;
    top: 9%;
    width: clamp(110px, 14vw, 230px);
    aspect-ratio: 270 / 165;
    background: var(--brand-cyan);
    -webkit-mask: url('/brand/birds.svg') center / contain no-repeat;
    mask: url('/brand/birds.svg') center / contain no-repeat;
    animation: fly 14s var(--ease-in-out) infinite alternate;
  }

  @keyframes fly {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(8vw, -2vh);
    }
  }

  /* ---------- CONTEÚDO ----------------------------------------------- */
  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: clamp(0.75rem, 2vh, 1.5rem);
    padding: clamp(0.5rem, 2vh, 1.5rem) var(--gutter) 0;
  }

  .hero__kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.9rem;
    font-size: var(--fs-caption);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text);
    background: rgb(102 58 107 / 0.55);
    border-radius: 999px;
    opacity: 0;
    animation: rise 900ms var(--ease-out) 150ms forwards;
  }

  .hero__live {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--brand-cyan);
    box-shadow: 0 0 0 0 rgb(0 202 254 / 0.7);
    animation: live 1.8s ease-out infinite;
  }

  @keyframes live {
    to {
      box-shadow: 0 0 0 10px rgb(0 202 254 / 0);
    }
  }

  .hero__title {
    width: min(100%, 1040px, calc((100svh - var(--frame) * 2 - var(--nav-h) - 300px) * 1.73));
    min-width: min(100%, 520px);
    color: var(--color-text);
    translate: calc(var(--mx) * -10px) calc(var(--my) * -6px);
  }

  .hero__title :global(.hero__logo) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 10px 30px rgb(102 58 107 / 0.35));
  }

  /* Montagem do logotipo, parte por parte */
  .hero__title :global(.lk) {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: 1000ms var(--ease-back) both;
  }

  .hero__title :global(.lk--mara) {
    animation-name: lk-drop;
    animation-delay: 200ms;
  }

  .hero__title :global(.lk--vira) {
    transform-origin: 0% 100%;
    animation-name: lk-vira;
    animation-delay: 420ms;
    animation-duration: 1200ms;
  }

  .hero__title :global(.lk--n27) {
    animation-name: lk-pop;
    animation-delay: 800ms;
  }

  .hero__title :global(.lk--rio) {
    animation: lk-write 900ms var(--ease-in-out) 1050ms both;
  }

  .hero__title :global(.lk--ed) {
    animation: lk-fade 800ms var(--ease-out) 1250ms both;
  }

  @keyframes lk-drop {
    from {
      opacity: 0;
      transform: translateY(-45%) rotate(-6deg);
    }
  }

  @keyframes lk-vira {
    from {
      opacity: 0;
      transform: rotate(32deg) translateY(25%);
    }
  }

  @keyframes lk-pop {
    from {
      opacity: 0;
      transform: scale(0.2) rotate(-25deg);
    }
  }

  @keyframes lk-write {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes lk-fade {
    from {
      opacity: 0;
      transform: translateY(30%);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- MULTIDÃO ----------------------------------------------- */
  .hero__crowd {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    height: clamp(170px, 32svh, 330px);
    color: var(--brand-purple);
    pointer-events: none;
  }

  .hero__crowd::after {
    content: '';
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(to bottom, transparent, rgb(102 58 107 / 0.9) 55%, var(--brand-purple));
  }

  .hero__crowd :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (min-width: 1000px) {
    .hero__crowd :global(.crowd-lights circle) {
      animation: twinkle 2.6s ease-in-out infinite alternate;
      animation-delay: var(--d);
    }
  }

  @keyframes twinkle {
    to {
      opacity: 0.25;
    }
  }

  /* ---------- BARRA: DATA / CHAMADA / CTAs ---------------------------- */
  .hero__bar {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(1.5rem, 3vw, 3rem);
    width: 100%;
    max-width: var(--max-w);
    margin-inline: auto;
    padding: clamp(1.25rem, 3vh, 2rem) var(--gutter) clamp(1.5rem, 4vh, 2.75rem);
    opacity: 0;
    animation: rise 1000ms var(--ease-out) 1300ms forwards;
  }

  .hero__date {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 0.85;
  }

  .hero__dd {
    font-size: clamp(3rem, 5.6vw, 5.25rem);
    letter-spacing: -0.03em;
    color: var(--brand-orange);
  }

  .hero__dmeta {
    display: grid;
    gap: 0.4rem;
    padding-left: 0.9rem;
    border-left: 2px solid rgb(255 255 255 / 0.3);
    font-size: clamp(0.95rem, 1.3vw, 1.25rem);
    letter-spacing: 0.01em;
  }

  .hero__pitch {
    text-shadow: 0 2px 16px rgb(33 15 40 / 0.6);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.9rem, 3.4vw, 3.25rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero__dot {
    color: var(--brand-cyan);
  }

  .hero__sub {
    max-width: 36rem;
    margin-top: 0.6rem;
  }

  .hero__ctas {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.4rem;
  }

  .hero__ctas :global(.btn--ghost) {
    align-self: center;
  }

  /* Saída no scroll (só CSS, progressive enhancement) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__content {
        animation: hero-exit linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes hero-exit {
    to {
      transform: scale(1.1) rotate(-3deg);
      opacity: 0.2;
    }
  }

  /* ---------- TABLET ------------------------------------------------- */
  @media (max-width: 1100px) {
    .hero__bar {
      grid-template-columns: auto 1fr;
    }

    .hero__ctas {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
  }

  @media (min-width: 721px) and (max-width: 1100px) and (orientation: portrait) {
    .hero__title {
      width: 100%;
    }
  }

  /* ---------- MOBILE ------------------------------------------------- */
  @media (max-width: 720px) {
    .hero__card {
      grid-template-rows: auto 1fr auto;
      border-radius: 18px;
    }

    .hero__content {
      padding-top: 1rem;
    }

    .hero__kicker {
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
    }

    .hero__org {
      display: none;
    }

    .hero__title {
      width: 106%;
      min-width: 0;
    }

    .palm {
      height: 62%;
      opacity: 0.9;
    }

    .palm--left {
      left: -20%;
    }

    .palm--right {
      top: auto;
      bottom: 24%;
      right: -24%;
    }

    .birds {
      left: 6%;
      top: 2%;
      width: 80px;
    }

    .hero__sun {
      right: -20%;
      top: 14%;
      width: 90vw;
    }

    .hero__crowd {
      height: 36svh;
    }

    .hero__bar {
      grid-row: 3;
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    }

    .hero__dd {
      font-size: 2.9rem;
    }

    .hero__dmeta {
      font-size: 0.95rem;
    }

    .hero__headline {
      font-size: 2.1rem;
    }

    .hero__sub {
      font-size: 0.98rem;
    }

    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 0.15rem;
    }

    .beam:nth-child(2) {
      display: none;
    }
  }

  /* Telas baixas (laptops ~1366×650) */
  @media (min-width: 721px) and (max-height: 760px) {
    .hero__sub {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero *,
    .hero *::before,
    .hero *::after {
      animation-duration: 1ms !important;
      animation-delay: 0ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
