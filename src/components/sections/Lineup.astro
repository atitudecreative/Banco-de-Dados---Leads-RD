---
/**
 * ATRAÇÕES — cards no formato dos posts oficiais de convidados.
 * Dados: src/config/event.ts → artists (confirmed: false = "A anunciar").
 * Desktop: mural de cards levemente inclinados. Mobile: carrossel com snap.
 */
import ArtistCard from '@/components/ui/ArtistCard.astro';
import Button from '@/components/ui/Button.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import { event } from '@/config/event';

const pending = event.artists.filter((a) => !a.confirmed).length;
---

<section class="lineup section" id="atracoes" aria-labelledby="atracoes-title">
  <span class="lineup__palm lineup__palm--l" aria-hidden="true"></span>
  <span class="lineup__palm lineup__palm--r" aria-hidden="true"></span>
  <div class="container">
    <div class="lineup__head">
      <SectionTitle id="atracoes-title" kicker="Atrações" lines={['Quem vai estar', 'no palco']} class="tilt" />
      <p class="lineup__note" data-reveal>
        Louvor, Palavra e celebração com convidados que vão marcar a sua virada.
        {pending > 0 && <span> Mais atrações serão anunciadas em breve.</span>}
      </p>
    </div>

    <ul class="lineup__grid" role="list">
      {
        event.artists.map((a, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <ArtistCard artist={a} index={i % 4} />
          </li>
        ))
      }
    </ul>

    <div class="lineup__cta" data-reveal>
      <p>Seja o primeiro a saber dos próximos nomes.</p>
      <Button href="#garanta" variant="light" data-track="cta-lineup">Quero ser avisado</Button>
    </div>
  </div>
</section>

<style>
  .lineup {
    overflow: hidden;
    background: var(--gradient-post);
  }

  .lineup__palm {
    position: absolute;
    top: -6%;
    z-index: 0;
    height: 75%;
    aspect-ratio: 440 / 1006;
    background: var(--brand-purple);
    opacity: 0.35;
    -webkit-mask: var(--m) center / contain no-repeat;
    mask: var(--m) center / contain no-repeat;
    pointer-events: none;
  }

  .lineup__palm--l {
    --m: url('/brand/palm-left.svg');
    left: -4%;
  }

  .lineup__palm--r {
    --m: url('/brand/palm-right.svg');
    right: -4%;
    top: 30%;
  }

  .lineup .container {
    position: relative;
    z-index: 1;
  }

  .lineup__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .lineup__head :global(.st) {
    margin-bottom: 0;
  }

  .lineup__head :global(.kicker) {
    color: var(--color-text);
  }

  .lineup__head :global(.st__title) {
    font-size: var(--fs-h1);
  }

  .lineup__note {
    max-width: 26rem;
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.4;
  }

  .lineup__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem) clamp(1.25rem, 2.5vw, 2.5rem);
  }

  .lineup__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.25rem, 2.5vw, 2rem) clamp(1.25rem, 3vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: rgb(33 15 40 / 0.35);
  }

  .lineup__cta p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 2.8vw, 2.4rem);
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  @media (max-width: 1000px) {
    .lineup__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Mobile: carrossel horizontal com snap (experiência própria) */
  @media (max-width: 640px) {
    .lineup__grid {
      display: flex;
      gap: 1rem;
      margin-inline: calc(var(--gutter) * -1);
      padding: 1rem var(--gutter) 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .lineup__grid::-webkit-scrollbar {
      display: none;
    }

    .lineup__grid > li {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }

    .lineup__cta :global(.btn) {
      width: 100%;
    }
  }
</style>
