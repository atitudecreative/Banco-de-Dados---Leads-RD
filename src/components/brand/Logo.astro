---
/**
 * Logotipo oficial "Rio MaraVira 27" (arquivos em public/brand/).
 * - compact: sem "2ª Edição / A Virada Maravilhosa" (nav, menu, selos)
 * - lockup: assinatura completa (rodapé)
 * O nome acessível vem do link que envolve o logo (ou de `alt`).
 */
interface Props {
  variant?: 'compact' | 'lockup';
  /** Altura em px (a largura segue a proporção do logo). */
  height?: number;
  alt?: string;
  class?: string;
  /** Logo acima da dobra (nav): baixa com prioridade alta. */
  priority?: boolean;
}
const { variant = 'compact', height = 40, alt = '', class: cls, priority = false } = Astro.props;
const src = variant === 'lockup' ? '/brand/maravira27-lockup.svg' : '/brand/maravira27-logo.svg';
const ratio = variant === 'lockup' ? 1360 / 785 : 1345 / 775;
---

<img class:list={['logo', cls]} src={src} alt={alt} width={Math.round(height * ratio)} height={height} style={`width:${Math.round(height * ratio)}px;height:${height}px`} decoding="async" fetchpriority={priority ? 'high' : undefined} loading={priority ? undefined : 'lazy'} />

<style>
  .logo {
    display: block;
    width: auto;
    max-width: none;
    aspect-ratio: auto;
    transition: transform var(--dur) var(--ease-back);
  }

  :global(a:hover) > .logo,
  :global(a:focus-visible) > .logo {
    transform: rotate(-3deg) scale(1.04);
  }
</style>
