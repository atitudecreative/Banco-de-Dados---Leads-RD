---
/**
 * CTA do MaraVira. Formato chanfrado (canto cortado, linguagem de ingresso /
 * sinalização de estádio). Renderiza <a> quando há href, senão <button>.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'ghost' | 'light';
  size?: 'md' | 'lg';
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  icon?: 'arrow' | 'play' | 'none';
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', external = false, type = 'button', class: cls, icon = 'arrow', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const linkProps = href
  ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : { type };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]} {...linkProps} {...rest}>
  <span class="btn__label"><slot /></span>
  {
    icon !== 'none' && (
      <span class="btn__icon" aria-hidden="true">
        {icon === 'arrow' ? (
          <svg viewBox="0 0 24 24" width="22" height="22">
            <path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" width="20" height="20">
            <path d="M7 4.5v15l13-7.5z" fill="currentColor" />
          </svg>
        )}
      </span>
    )
  }
  {external && <span class="sr-only"> (abre em nova aba)</span>}
</Tag>

<style>
  .btn {
    --chamfer: 14px;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    min-height: 3.5rem;
    padding: 0.95rem 1.5rem 0.95rem 1.75rem;
    font-family: var(--font-display);
    font-size: var(--fs-button);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    clip-path: polygon(0 0, calc(100% - var(--chamfer)) 0, 100% var(--chamfer), 100% 100%, var(--chamfer) 100%, 0 calc(100% - var(--chamfer)));
    transition:
      transform var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      filter var(--dur) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .btn--lg {
    --chamfer: 18px;
    min-height: 4.25rem;
    padding: 1.2rem 1.9rem 1.2rem 2.25rem;
    font-size: clamp(1.2rem, 1rem + 0.6vw, 1.55rem);
  }

  /* Camada de cor (fica atrás e "varre" no hover) */
  .btn::before,
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur) var(--ease-out);
  }

  .btn--primary {
    color: var(--color-text);
  }

  .btn--primary::before {
    background: var(--gradient-virada);
    background-size: 200% 100%;
    background-position: 0% 50%;
    transition: background-position var(--dur-slow) var(--ease-out);
  }

  .btn--primary::after {
    background: var(--color-text);
    transform: translateX(-101%);
  }

  .btn--light {
    color: var(--color-ink);
  }

  .btn--light::before {
    background: var(--color-text);
  }

  .btn--light::after {
    background: var(--gradient-virada);
    transform: translateX(-101%);
  }

  .btn--ghost {
    color: var(--color-text);
    clip-path: none;
    padding-inline: 0.25rem;
    min-height: 3rem;
  }

  .btn--ghost::before {
    inset: auto 0 0.35rem 0;
    height: 2px;
    background: var(--gradient-virada);
    transform-origin: right;
  }

  .btn--ghost::after {
    display: none;
  }

  .btn__icon {
    display: inline-grid;
    place-items: center;
    transition: transform var(--dur) var(--ease-out);
  }

  /* --- Hover (apenas dispositivos com ponteiro real) --- */
  @media (hover: hover) {
    .btn--primary:hover {
      color: var(--color-ink);
    }

    .btn--primary:hover::after,
    .btn--light:hover::after {
      transform: none;
    }

    .btn--light:hover {
      color: var(--color-text);
    }

    .btn:hover .btn__icon {
      transform: translateX(5px);
    }

    .btn--ghost:hover::before {
      transform: scaleX(0.35);
    }
  }

  /* --- Focus (teclado): mesmo feedback do hover + anel --- */
  .btn:focus-visible {
    outline: none;
    filter: drop-shadow(0 0 0 var(--color-accent)) drop-shadow(0 0 3px var(--color-accent)) drop-shadow(0 0 1px var(--color-accent));
  }

  .btn--primary:focus-visible {
    color: var(--color-ink);
  }

  .btn--primary:focus-visible::after,
  .btn--light:focus-visible::after {
    transform: none;
  }

  .btn--light:focus-visible {
    color: var(--color-text);
  }

  .btn--ghost:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
    filter: none;
  }

  /* --- Active --- */
  .btn:active {
    transform: scale(0.97);
    transition-duration: 80ms;
  }

  .btn[disabled],
  .btn[aria-disabled='true'] {
    opacity: 0.55;
    pointer-events: none;
  }
</style>
