---
/**
 * Faixa corrida estilo festival. Puro CSS (transform), pausa em
 * prefers-reduced-motion. O conteúdo é duplicado para o loop contínuo;
 * a cópia fica oculta para leitores de tela.
 */
interface Props {
  items: string[];
  variant?: 'gradient' | 'outline' | 'light';
  reverse?: boolean;
  tilt?: number;
  speed?: number;
  class?: string;
}
const { items, variant = 'gradient', reverse = false, tilt = 0, speed = 38, class: cls } = Astro.props;
---

<div class="mq-clip">
<div class:list={['mq', `mq--${variant}`, { 'mq--reverse': reverse }, cls]} style={`--tilt:${tilt}deg;--speed:${speed}s`} role="presentation">
  <div class="mq__track">
    {
      [0, 1].map((copy) => (
        <ul class="mq__group" role="list" aria-hidden={copy === 1 ? 'true' : undefined}>
          {items.map((t) => (
            <li>
              <span>{t}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z" fill="currentColor" />
              </svg>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
</div>

<style>
  .mq-clip {
    overflow: hidden;
    padding-block: clamp(1rem, 3vw, 2.5rem);
    margin-block: calc(clamp(1rem, 3vw, 2.5rem) * -1);
    position: relative;
    z-index: 2;
  }

  .mq {
    position: relative;
    z-index: 2;
    overflow: hidden;
    rotate: var(--tilt);
    width: 104%;
    margin-left: -2%;
    padding-block: clamp(0.7rem, 1.5vw, 1.1rem);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.6rem, 3.6vw, 3.1rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .mq--gradient {
    background: var(--brand-orange);
    color: var(--brand-purple);
  }

  .mq--gradient svg {
    color: var(--color-text);
  }

  .mq--light {
    background: var(--color-text);
    color: var(--color-ink);
  }

  .mq--outline {
    border-block: 1px solid var(--color-line);
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-text);
  }

  .mq--outline svg {
    color: var(--brand-cyan);
  }

  .mq__track {
    display: flex;
    width: max-content;
    animation: mq var(--speed) linear infinite;
  }

  .mq--reverse .mq__track {
    animation-direction: reverse;
  }

  .mq__group {
    display: flex;
    flex: none;
  }

  .mq__group li {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding-right: 0.5em;
  }

  .mq svg {
    width: 0.55em;
    height: 0.55em;
    flex: none;
  }

  @keyframes mq {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mq__track {
      animation: none;
    }
  }
</style>
