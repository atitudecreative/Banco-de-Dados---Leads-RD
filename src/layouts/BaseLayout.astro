---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/manrope';
import '@/styles/global.css';
import displayFont from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import { event, countdownTarget, dateParts } from '@/config/event';

interface Props {
  title?: string;
  description?: string;
  /** Caminho da página, ex.: "/" ou "/privacidade" */
  path?: string;
  noindex?: boolean;
  /** Inclui o JSON-LD schema.org/Event (só na home). */
  eventSchema?: boolean;
}

const { title = event.seo.title, description = event.seo.description, path = '/', noindex = false, eventSchema = false } = Astro.props;

const site = event.seo.siteUrl;
const canonical = new URL(path, site).href;
const ogImage = new URL(event.seo.ogImage, site).href;

// schema.org/Event — usa apenas dados confirmados da configuração.
const v = event.venue;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${event.eventName} ${event.eventYear}`,
  description: event.seo.description,
  // Sem horário confirmado, publicamos só a data (formato válido ISO 8601).
  startDate: event.eventTime ? countdownTarget : event.eventDate,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  inLanguage: 'pt-BR',
  image: [ogImage],
  url: site,
  location: {
    '@type': 'Place',
    ...(v.name ? { name: v.name } : { name: `${event.city}, ${event.state}` }),
    address: {
      '@type': 'PostalAddress',
      ...(v.address ? { streetAddress: v.address } : {}),
      ...(v.postalCode ? { postalCode: v.postalCode } : {}),
      addressLocality: event.city,
      addressRegion: event.state,
      addressCountry: 'BR',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: event.organizer,
    ...(event.organizerUrl ? { url: event.organizerUrl } : {}),
  },
  ...(event.ticketUrl
    ? {
        offers: {
          '@type': 'Offer',
          url: event.ticketUrl,
          availability: 'https://schema.org/InStock',
        },
      }
    : {}),
  ...(event.artists.some((a) => a.confirmed)
    ? {
        performer: event.artists
          .filter((a) => a.confirmed)
          .map((a) => ({ '@type': 'PerformingGroup', name: a.name })),
      }
    : {}),
};
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="theme-color" content="#07060c" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${event.eventName} ${event.eventYear}`} />
    <meta property="og:locale" content={event.seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${event.eventName} ${event.eventYear} — ${dateParts.long}, ${event.city}`} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {event.seo.twitterHandle && <meta name="twitter:site" content={event.seo.twitterHandle} />}

    {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
