---
/** Layout de páginas internas (legais, 404): mesma identidade, sem a página longa. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Logo from '@/components/brand/Logo.astro';
import Footer from '@/components/sections/Footer.astro';
import { event } from '@/config/event';

interface Props {
  title: string;
  description?: string;
  path: string;
  kicker?: string;
  noindex?: boolean;
}
const { title, description, path, kicker, noindex } = Astro.props;
---

<BaseLayout title={`${title} — ${event.eventName} ${event.eventYear}`} description={description} path={path} noindex={noindex}>
  <header class="pnav">
    <a href="/" aria-label={`${event.eventName} ${event.eventYear} — início`}><Logo height={44} /></a>
    <a class="pnav__back" href="/">← Voltar ao site</a>
  </header>
  <main id="conteudo" class="page container">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1 class="page__title">{title}</h1>
    <div class="page__body"><slot /></div>
  </main>
  <Footer minimal />
</BaseLayout>

<style>
  .pnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-w);
    height: var(--nav-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .pnav a {
    font-size: 0.95rem;
    text-decoration: none;
  }

  .pnav__back {
    font-size: var(--fs-caption) !important;
    font-weight: 800;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .page {
    padding-block: clamp(3rem, 8vw, 7rem);
  }

  .page__title {
    margin-block: 1.25rem 2.5rem;
    font-size: var(--fs-h1);
    font-weight: 900;
  }

  .page__body {
    max-width: 46rem;
    color: var(--color-muted);
  }

  .page__body :global(h2) {
    margin-block: 2.5rem 0.75rem;
    font-size: var(--fs-h3);
    color: var(--color-text);
  }

  .page__body :global(p + p) {
    margin-top: 1rem;
  }
</style>
